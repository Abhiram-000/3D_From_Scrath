# EDU-3D server — production
#
# Every variable marked required below is checked at startup, and *all* problems are reported at once
# rather than one restart at a time. The server refuses to start when production would be unsafe:
# unauthenticated writes, no database, or an origin list that trusts everything.

# ── AI provider ───────────────────────────────────────────────────────────────
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_CHAT_MODEL=
AI_MAX_OUTPUT_TOKENS=32000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
# Required. The platform's own advertised URL; it is derived into the CORS allow-list so a first
# deploy works without hand-listing origins.
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=
# Required. The single most consequential deployed-server setting: with it unset, every visitor
# behind the platform router shares one rate-limit bucket and the fourth concurrent visitor starts
# receiving 429s while nowhere near the limit. Set to the number of proxy hops to trust.
TRUST_PROXY=1

# ── Storage ───────────────────────────────────────────────────────────────────
# Required. An unreachable DATABASE_URL in production is fatal rather than demoted, because silently
# demoting to the local store makes successful writes vanish on the next redeploy.
DATABASE_URL=
EDU3D_DB_SSL_REJECT_UNAUTHORIZED=true
EDU3D_DATA_DIR=/var/lib/edu3d
# Only set this if you genuinely accept a gallery that disappears when the filesystem is replaced.
EDU3D_ALLOW_EPHEMERAL_STORE=false

# ── Security ──────────────────────────────────────────────────────────────────
# Required. Guards publish and delete. Compared in constant time; travels in a header, never a URL.
EDU3D_WRITE_TOKEN=
EDU3D_ALLOW_OPEN_WRITES=false
EDU3D_CSP=enforce
EDU3D_HSTS=true
# Leave false when the platform terminates TLS at the edge; doing it twice is waste.
EDU3D_FORCE_HTTPS=false

# ── Budgets (requests per window) ──────────────────────────────────────────────
# A classroom behind one NAT address is one IP, so raise the generation ceiling for school
# deployments rather than telling thirty students to take turns.
EDU3D_API_RATE_LIMIT=600
EDU3D_WRITE_RATE_LIMIT=30
EDU3D_GENERATE_RATE_LIMIT=40
EDU3D_CHAT_RATE_LIMIT=120
EDU3D_QUIZ_RATE_LIMIT=60

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

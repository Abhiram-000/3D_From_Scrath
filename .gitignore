# Local data: the file-backed gallery fallback and rejected-generation artifacts
.data/
artifacts/

# Test output
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
# Playwright MCP session artifacts: page snapshots written by the browser tool.
.playwright-mcp/

# EDU-3D deployment environment — copy to deploy.env, fill what you need, `docker compose up`.
#
# Only AI_API_KEY costs functionality when missing: the viewer, gallery and reference model work
# with zero configuration. There is no login and no other required setup.

# ── AI generation (the only key that unlocks a feature) ─────────────────────
# FreeInference free tier — tested defaults. https://freeinference.org
AI_API_KEY=
AI_BASE_URL=https://freeinference.org/v1
AI_MODEL=deepseek-v4-flash
AI_CHAT_MODEL=deepseek-v4-flash

# Optional second provider; generation crosses to it when the primary is throttled or down.
# Tested with Gemini's OpenAI-compatible endpoint.
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_AI_MODEL=gemini-3.8-flash

# ── Durable storage (optional) ───────────────────────────────────────────────
# Without DATABASE_URL the gallery persists to the /data volume (survives redeploys on the same
# host). With it, storage upgrades to Postgres — uncomment the postgres service in
# docker-compose.yml and set:
# DATABASE_URL=postgres://edu3d:edu3d@postgres:5432/edu3d

# ── Deployment shape (already set correctly by docker-compose) ───────────────
# NODE_ENV=production, HOST=0.0.0.0, PORT=8787, TRUST_PROXY=1,
# EDU3D_ALLOW_EPHEMERAL_STORE=true, EDU3D_DATA_DIR=/data — set there; no need to repeat here.

# ── Only for split deployments (frontend hosted elsewhere) ───────────────────
# PUBLIC_ORIGIN=https://your-frontend.example
# ALLOWED_ORIGINS=https://your-frontend.example

# ── Write protection (recommended once public) ───────────────────────────────
# Without a token, publish/delete are open (fine while small). Set a long random string and
# keep it private; the Share modal's publish is unaffected (it is server-side).
# EDU3D_WRITE_TOKEN=

# EDU-3D deployment environment — copy to deploy.env, fill what you need, `docker compose up`.
#
# Only AI_API_KEY costs functionality when missing: the viewer, gallery and reference model work
# with zero configuration. There is no login and no other required setup.

# ── AI generation (the only key that unlocks a feature) ─────────────────────
# FreeInference free tier — tested defaults. https://freeinference.org
AI_API_KEY=
AI_BASE_URL=https://freeinference.org/v1
AI_MODEL=deepseek-v4-flash
AI_CHAT_MODEL=deepseek-v4-flash

# Generation concurrency and queueing. The free tier allows EXACTLY ONE concurrent request
# (a second gets a 429 concurrency_limit_exceeded) and generations run minutes, so extra learners
# wait in a process-global FIFO queue instead of failing. Set AI_MAX_CONCURRENCY to the limit of
# whatever plan you pay for. Queue depth is exposed on /api/health; a request queued longer than
# AI_QUEUE_MAX_WAIT_MS fails with rate_limited and a retry-after rather than waiting forever.
AI_MAX_CONCURRENCY=1
AI_QUEUE_MAX_WAIT_MS=900000

# Output ceiling. Provider ceilings (its /models endpoint): deepseek-v4-flash 393,216;
# glm-5.3-flash 131,072; qwen3.6-35b 8,192. 131,072 is the largest cap every cascade-eligible
# model honours (the old 64,000 asked for 6× less than the primary allows — the cheapest fix for
# the measured truncations). Models with a known ceiling below this request are skipped by the
# cascade, never advanced to (a guaranteed paid truncation).
AI_MAX_OUTPUT_TOKENS=131072

# Optional second provider; generation crosses to it when the primary is throttled or down.
# Tested with Gemini's OpenAI-compatible endpoint.
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_AI_MODEL=gemini-3.8-flash

# ── Durable storage (optional) ───────────────────────────────────────────────
# Without DATABASE_URL the gallery persists to the /data volume (survives redeploys on the same
# host). With it, storage upgrades to Postgres — uncomment the postgres service in
# docker-compose.yml and set:
# DATABASE_URL=postgres://edu3d:edu3d@postgres:5432/edu3d

# ── Deployment shape (already set correctly by docker-compose) ───────────────
# NODE_ENV=production, HOST=0.0.0.0, PORT=8787, TRUST_PROXY=1,
# EDU3D_ALLOW_EPHEMERAL_STORE=true, EDU3D_DATA_DIR=/data — set there; no need to repeat here.

# Only for split deployments (frontend hosted elsewhere)
# PUBLIC_ORIGIN=https://your-frontend.example
# ALLOWED_ORIGINS=https://your-frontend.example

# ── Write protection (REQUIRED before the server will start) ────────────────
# Fill this in; empty here means `docker compose up` exits with a configuration error naming
# this variable. The token guards POST/DELETE /api/gallery: publishing and deleting from the
# browser go through those routes with `Authorization: Bearer <token>`, and the Share modal
# prompts for the token once and stores it in localStorage (key `edu3d.publish.token`) so it
# survives the session. Generate one with e.g. `openssl rand -hex 32`.
#
# If you genuinely want a sandbox where anyone on the network can publish, set
# EDU3D_ALLOW_OPEN_WRITES=true instead (docker-compose does not set it either).
EDU3D_WRITE_TOKEN=

# ── Auto-save (on by default) ───────────────────────────────────────────────
# A successful generation persists its bundle to the gallery by itself, so the next visit shows it
# without a Publish click. This is the server saving its OWN output and is NOT covered by the write
# token above (which guards the public POST /api/gallery route only); a store write that throws is
# logged and swallowed, never failing the learner's generation. The auto-saved entry's id rides the
# terminal `ready` event as `galleryId`, so pressing Publish updates that entry in place rather than
# creating a duplicate. Set false to keep generated models browser-only.
EDU3D_AUTO_SAVE_GENERATIONS=true

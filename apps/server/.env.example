# EDU-3D server — local development
#
# Copy to `.env` and fill in. Never commit `.env`: `scripts/check-secrets.mjs` fails the build if you
# do. A real environment variable always beats a value in this file, so CI and containers work
# unchanged.
#
# Values are intentionally blank for every credential. `scripts/check-config.mjs` enforces that.

# ── AI provider ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Generation and chat both go through this one client, so swapping
# provider is a config change, not a code change.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# A cheaper model for chat and quiz keeps a chatty tutor session from eating the generation budget.
AI_CHAT_MODEL=
# Output ceiling for generation. The provider permits 393,216 on deepseek-v4-flash and 131,072 on
# glm-5.3-flash, so 131072 sits at the fallback family's ceiling — the largest cap every
# cascade-eligible model can honour. (The old 64,000 was 6× LESS than the model allows; a program
# at that size costs ~8 cents at $1.32/M completion.) Stay within the CONFIGURED model's ceiling.
AI_MAX_OUTPUT_TOKENS=131072
# How many generations may hit the provider at once — a property of the plan you are paying for.
# FreeInference's free tier refuses anything past ONE concurrent request with a 429
# (concurrency_limit_exceeded), and generations take minutes, so extra learners are QUEUED (FIFO)
# instead of failing. Queue depth is visible on /api/health.
AI_MAX_CONCURRENCY=1
# Bounded wait for a generation slot, milliseconds. A request queued longer than this fails with
# rate_limited (429) and a retry-after, instead of parking behind a stack of minute-long runs.
# 900000 = 15 minutes: a few multi-minute generations deep.
AI_QUEUE_MAX_WAIT_MS=900000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
# Extra CORS origins, comma separated. localhost is trusted automatically outside production.
ALLOWED_ORIGINS=

# ── Storage ───────────────────────────────────────────────────────────────────
# Leave empty to use the file-backed fallback store. It announces itself at startup and writes
# through to disk, because a purely in-memory gallery loses every shared link on restart with no
# error anywhere.
DATABASE_URL=
EDU3D_DB_SSL_REJECT_UNAUTHORIZED=false
EDU3D_DATA_DIR=.data

# ── Security ──────────────────────────────────────────────────────────────────
# With no token, writes stay open in development and start-up says so. In production there is no
# such default: the server refuses to start without a token (or an explicit EDU3D_ALLOW_OPEN_WRITES
# acceptance), and its write guard fails closed to 401s at request time. When a token IS set, every
# write needs `Authorization: Bearer <token>` — including the Share modal's publish from the
# browser, which prompts for the token once and stores it in localStorage (edu3d.publish.token).
EDU3D_WRITE_TOKEN=
EDU3D_CSP=report-only

# ── Budgets (requests per window) ──────────────────────────────────────────────
EDU3D_API_RATE_LIMIT=600
EDU3D_WRITE_RATE_LIMIT=30
EDU3D_GENERATE_RATE_LIMIT=12
EDU3D_CHAT_RATE_LIMIT=60
EDU3D_QUIZ_RATE_LIMIT=30

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty

# ── Fallback AI provider (optional but recommended) ───────────────────────────
# An independent provider with its own quota. When every model of the primary provider is
# throttled or unavailable, generation crosses to this one instead of failing the learner's wait.
# Tested defaults: FreeInference's free tier, deepseek-v4-flash (1M context, agentic coding).
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=https://freeinference.org/v1
FALLBACK_AI_MODEL=deepseek-v4-flash
